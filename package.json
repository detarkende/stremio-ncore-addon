{
  "name": "stremio-ncore-addon",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo build",
    "dev": "concurrently --kill-others \"pnpm --filter server dev\" \"pnpm --filter client dev\"",
    "start": "NODE_ENV=production node server/dist/index.js",
    "preview": "NODE_ENV=production node --env-file .env server/dist/index.js | pino-pretty",
    "ci": "pnpm check-formatting && pnpm lint && pnpm test",
    "check-formatting": "prettier --check .",
    "format": "prettier --write .",
    "lint": "turbo lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:watch-ui": "vitest --ui",
    "release": "docker buildx build --platform linux/amd64,linux/arm64 -t detarkende/stremio-ncore-addon:$npm_config_name . --push",
    "clean:deps": "find . -name node_modules -type d -prune -exec rm -rf '{}' +",
    "clean:cache": "find . -name .turbo -type d -prune -exec rm -rf '{}' +",
    "clean:dist": "find . -name dist -type d -prune -exec rm -rf '{}' +",
    "clean:all": "pnpm clean:deps & pnpm clean:cache & pnpm clean:dist"
  },
  "dependencies": {
    "cron-validator": "^1.4.0",
    "zod": "4.3.4"
  },
  "devDependencies": {
    "@vitest/coverage-istanbul": "^4.0.18",
    "@vitest/ui": "^4.0.18",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.3",
    "prettier": "^3.8.1",
    "tsc-alias": "^1.8.16",
    "turbo": "^2.8.10",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vite-tsconfig-paths": "6.0.0-beta.4",
    "vitest": "^4.0.18"
  },
  "pnpm": {
    "allowUnusedPatches": true,
    "patchedDependencies": {
      "@types/parse-torrent": "patches/@types__parse-torrent.patch",
      "@types/stremio-addon-sdk": "patches/@types__stremio-addon-sdk.patch",
      "webtorrent": "patches/webtorrent.patch"
    },
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "bufferutil",
      "esbuild",
      "node-datachannel",
      "utf-8-validate",
      "utp-native"
    ]
  },
  "packageManager": "pnpm@10.27.0"
}
