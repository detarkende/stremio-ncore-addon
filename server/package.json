{
  "name": "@sna/server",
  "type": "module",
  "exports": {
    ".": {
      "@sna/source": "./src/exports.ts",
      "types": "./dist/exports.d.ts",
      "default": "./dist/exports.js"
    }
  },
  "scripts": {
    "dev": "node --watch --env-file ../.env --experimental-transform-types --import tsx src/index.ts | pino-pretty",
    "start": "node --env-file --enable-source-maps ../.env ./dist/index.js",
    "build": "node ./scripts/build.ts",
    "typecheck": "tsc --noemit -p ./tsconfig.app.json",
    "db:generate": "ADDON_DIR=downloads drizzle-kit generate --name",
    "lint": "eslint ."
  },
  "dependencies": {
    "@ctrl/video-filename-parser": "^5.4.1",
    "@hono/node-server": "^1.19.9",
    "@hono/zod-validator": "^0.4.3",
    "@libsql/client": "^0.15.15",
    "@oslojs/crypto": "^1.0.1",
    "@oslojs/encoding": "^1.1.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.6.2",
    "content-disposition": "^0.5.4",
    "drizzle-orm": "^0.38.4",
    "hono": "^4.12.1",
    "jsdom": "^25.0.1",
    "lru-cache": "^11.2.6",
    "node-cron": "4.2.1",
    "parse-torrent": "^11.0.19",
    "pino": "^9.14.0",
    "pino-roll": "^3.1.0",
    "range-parser": "^1.2.1",
    "set-cookie-parser": "^2.7.2",
    "vitest": "^2.1.9",
    "webtorrent": "^2.8.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/bittorrent-protocol": "^3.1.7",
    "@types/content-disposition": "^0.5.9",
    "@types/jsdom": "^21.1.7",
    "@types/mock-fs": "^4.13.4",
    "@types/node": "^22.19.11",
    "@types/parse-torrent": "^5.8.8",
    "@types/range-parser": "^1.2.7",
    "@types/set-cookie-parser": "^2.4.10",
    "@types/simple-peer": "^9.11.9",
    "@types/stremio-addon-sdk": "^1.6.12",
    "@vitest/coverage-istanbul": "2.1.9",
    "@vitest/coverage-v8": "2.1.9",
    "bitfield": "^4.2.0",
    "drizzle-kit": "^0.30.6",
    "esbuild": "^0.25.12",
    "eslint-plugin-import": "^2.32.0",
    "globals": "^16.5.0",
    "mock-fs": "^5.5.0",
    "nock": "^14.0.11",
    "pino-pretty": "^13.1.3",
    "simple-peer": "^9.11.1",
    "stremio-addon-sdk": "^1.6.10",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.0"
  },
  "peerDependencies": {
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=20.6.0"
  }
}
